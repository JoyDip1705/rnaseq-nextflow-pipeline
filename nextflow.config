//nextflow config file

docker {

   enabled = true

}

executor {

   cpus = 16

}

process.shell = ['/bin/bash', '-euo', 'pipefail']

process {

   withName: QUALITY {
      container = "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"
      cpus = 4
      debug = true

   }

   withName: TRIMMING {
      container = "quay.io/biocontainers/trimmomatic:0.39--hdfd78af_2"
      cpus      = 4
      debug = true

   }

   withName: INDEXING {
      container = "quay.io/biocontainers/hisat2:2.2.1--h1b792b2_3"
      cpus      = 8
      debug = true
   }

   withName: MAPPING_SORT {
      container = "quay.io/biocontainers/mulled-v2-a97e90b3b802d1da3d6958e0867610c718cb5eb1:2880dd9d8ad0a7b221d4eacda9a818e92983128d-0"
      cpus      = 8
      debug = true
   }

   withName: QUANTIFICATION {
      container = "quay.io/biocontainers/subread:2.0.1--hed695b0_0"
      cpus      = 8
      memory    = '8 GB'
      debug = true

   }

   withName: MERGING_COUNT {
      container = "quay.io/biocontainers/pandas:1.5.2"
      cpus      = 1
      debug     = true

   }

   withName: DEG {
      container = "quay.io/biocontainers/bioconductor-deseq2:1.42.0--r43hf17093f_0"
      cpus = 8
      memory    = '8 GB'
      debug = true
      

   }

}
